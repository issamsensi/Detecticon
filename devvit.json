{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "detecticon",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "media": {
    "dir": "public"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "detecticon",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Create today’s Detecticon post",
        "description": "Create today's daily Detecticon post (skips if already created for this UTC date)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create-today"
      },
      {
        "label": "Dev: reset my progress for today",
        "description": "Clear your saved attempts and share flags so you can replay and reshare today's puzzle",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dev-reset-progress"
      },
      {
        "label": "Dev: reset today's stats",
        "description": "Delete today's solve counters so test plays don't pollute the stats",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dev-reset-stats"
      },
      {
        "label": "Dev: test puzzle override",
        "description": "Choose a puzzle id to replace today's puzzle for testing",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dev-set-override"
      },
      {
        "label": "Dev: clear puzzle override",
        "description": "Remove the test puzzle override and restore the normal daily rotation",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dev-clear-override"
      },
      {
        "label": "Dev: reset this week's leaderboard",
        "description": "Delete the current UTC week's Detecticon leaderboard so test scores don't pollute it",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dev-reset-weekly-leaderboard"
      }
    ]
  },
  "forms": {
    "devPuzzleOverride": "/internal/form/dev-puzzle-override"
  },
  "scheduler": {
    "tasks": {
      "daily-detectivo-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "5 0 * * *"
      }
    }
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_POST",
        "SUBMIT_COMMENT",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "detecticon_dev2"
  }
}